# Header Cloudflare Static Assets (berkas ini tidak ikut disajikan).
# sw.js harus selalu diperiksa ulang agar versi baru terdeteksi.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/icons/*
  Cache-Control: public, max-age=604800
